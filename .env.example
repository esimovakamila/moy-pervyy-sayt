# Пример переменных окружения для бэкенда/сервиса отправки формы заявки.
# Пригодится, если вместо статичной страницы вы подключите настоящий сервер
# или serverless-функцию (Formspree, EmailJS, свой API) для обработки формы.
# Скопируйте в .env на сервере и никогда не коммитьте .env с реальными
# значениями — сам .env уже добавлен в .gitignore.

CONTACT_PHONE=+70000000000
CONTACT_INSTAGRAM_URL=https://instagram.com/your.handle
CONTACT_WHATSAPP_URL=https://wa.me/qr/YOUR_CODE
FORM_ENDPOINT=https://formspree.io/f/your-form-id
